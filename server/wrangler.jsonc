{
  // The online room server: one Durable Object per room, WebSocket relay.
  // Deploy: npm run net:deploy   Dev: npm run net:dev (port 8787)
  "name": "banjopocalypse-net",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "observability": { "enabled": true },
  "durable_objects": {
    "bindings": [{ "name": "ROOM", "class_name": "RoomDO" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RoomDO"] }]
}
